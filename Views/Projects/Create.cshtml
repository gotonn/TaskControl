@model ProjectCreateViewModel
@{
    ViewData["Title"] = "Новий проєкт";
}
<div class="page-header">
    <div>
        <div class="eyebrow">Планування</div>
        <h1>Новий проєкт</h1>
        <p>Створіть робочий напрям і прив'яжіть його до команди.</p>
    </div>
    <a asp-action="Index" class="btn btn-light">Назад</a>
</div>
<div class="panel max-form">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Назва</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Опис</label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="TeamId" class="form-label">Команда</label>
                <select asp-for="TeamId" class="form-select">
                    @foreach (var team in Model.Teams)
                    {
                        <option value="@team.Value">@team.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label">Статус</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<WorkProjectStatus>()" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label">Дата початку</label>
                <input asp-for="StartDate" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label">Дата завершення</label>
                <input asp-for="EndDate" class="form-control" type="date" />
            </div>
            <div class="col-md-12">
                <label asp-for="Color" class="form-label">Колір</label>
                <input asp-for="Color" class="form-control form-control-color" type="color" />
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Створити проєкт</button>
            <a asp-action="Index" class="btn btn-light">Скасувати</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
