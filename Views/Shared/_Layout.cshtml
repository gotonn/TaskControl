<!doctype html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – TaskControl</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-check2-square"></i></span>
                <span>TaskControl</span>
            </a>
            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Панель</a>
                <a asp-controller="Tasks" asp-action="Index"><i class="bi bi-list-task"></i> Завдання</a>
                <a asp-controller="Tasks" asp-action="Kanban"><i class="bi bi-kanban"></i> Kanban</a>
                <a asp-controller="Projects" asp-action="Index"><i class="bi bi-folder2-open"></i> Проєкти</a>
                <a asp-controller="Teams" asp-action="Index"><i class="bi bi-people"></i> Команди</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a asp-controller="Users" asp-action="Index"><i class="bi bi-person-lines-fill"></i> Користувачі</a>
                }
                <a asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i> Сповіщення</a>
            </nav>
            <div class="sidebar-footer">
                <div class="user-mini">
                    <div class="avatar">@User.Identity.Name?.Substring(0, 1).ToUpper()</div>
                    <div class="user-mini-body">
                        <div class="small fw-semibold text-white">@User.Identity.Name</div>
                        <div class="tiny text-white-50">активний користувач</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-light w-100 mt-3" type="submit"><i class="bi bi-box-arrow-right"></i> Вийти</button>
                </form>
            </div>
        </aside>
        <main class="content-area">
            @RenderBody()
        </main>
    </div>
}
else
{
    <main>
        @RenderBody()
    </main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
